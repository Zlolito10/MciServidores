# Public Firebase Web API key, already present in the client configuration.
# Set this only when testing the optional password-login endpoint.
MCI_FIREBASE_WEB_API_KEY=

# Optional archive destination; empty preserves the recovered folder ID.
MCI_DRIVE_ARCHIVE_FOLDER_ID=
# adc requires an identified service account and a writable Shared Drive folder.
# oauth uses offline user credentials already provided securely to the runtime.
MCI_DRIVE_AUTH_MODE=adc
# Set these only in oauth mode. Never commit real values or send them in chat.
MCI_DRIVE_OAUTH_CLIENT_ID=
MCI_DRIVE_OAUTH_CLIENT_SECRET=
MCI_DRIVE_OAUTH_REFRESH_TOKEN=
# Optional identity lock; the consent/bootstrap should set the selected owner's email.
MCI_DRIVE_OAUTH_EXPECTED_EMAIL=

# Optional additional deployed HTTPS application origins, comma separated.
# Firebase Hosting origins are already allowed; loopback is allowed only in demo.
MCI_ALLOWED_ORIGINS=
