{
  "headers": [
    {
      "headers": {
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-XSS-Protection": "0",
        "X-Permitted-Cross-Domain-Policies": "none",
        "Permissions-Policy": "geolocation=(self), camera=(self), microphone=()",
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: blob:; connect-src 'self' https: wss:; frame-src 'self' https:; media-src 'self' data: blob:; upgrade-insecure-requests",
        "X-Content-Type-Options": "nosniff"
      },
      "glob": "/**"
    },
    {
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      },
      "glob": "/firebase-messaging-sw.js"
    },
    {
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      },
      "glob": "/manifest.json"
    },
    {
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      },
      "glob": "/app-version.json"
    },
    {
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "glob": "/index.html"
    },
    {
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "glob": "**/*.html"
    },
    {
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "glob": "/assets/**"
    }
  ],
  "rewrites": [
    {
      "functionRegion": "us-central1",
      "glob": "/api/**",
      "function": "serverApi"
    },
    {
      "functionRegion": "us-central1",
      "glob": "/comments/**",
      "function": "serverApi"
    },
    {
      "glob": "**",
      "path": "/index.html"
    }
  ]
}
